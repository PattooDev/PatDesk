(defpoll time
  :interval "1s"
  `date '+%H:%M:%S'`)

(defpoll date
  :interval "60s"
  `date '+%A %d %B %Y'`)

(defpoll cpu
  :interval "2s"
  `$HOME/.config/patdesk/scripts/cpu.sh`)

(defpoll ram
  :interval "2s"
  `$HOME/.config/patdesk/scripts/ram.sh`)

(defpoll disks
  :interval "30s"
  `$HOME/.config/patdesk/scripts/disks.py`)

(defpoll cpu_temp
  :interval "5s"
  `$HOME/.config/patdesk/scripts/cpu-temp.sh`)

(defpoll gpu_temp
  :interval "5s"
  `$HOME/.config/patdesk/scripts/gpu-temp.sh`)

(defpoll network
  :interval "2s"
  `$HOME/.config/patdesk/scripts/network.py`)

(defpoll updates
  :interval "10m"
  `$HOME/.config/patdesk/scripts/updates.py`)

(defwidget metric [name value bar-class]
  (box
    :orientation "vertical"
    :class "metric"
    :space-evenly false

    (box
      :orientation "horizontal"
      :class "metric-row"
      :space-evenly false

      (label
        :class "metric-name"
        :halign "start"
        :hexpand true
        :text name)

      (label
        :class "metric-value"
        :halign "end"
        :text "${value}%"))

    (progress
      :class "metric-bar ${bar-class}"
      :value value
      :orientation "horizontal")))

(defwidget temp-metric [name value bar-class warning critical]
  (box
    :orientation "vertical"
    :class "metric temp-metric ${value >= critical ? 'alert-critical' : value >= warning ? 'alert-warning' : 'alert-normal'}"
    :space-evenly false

    (box
      :orientation "horizontal"
      :class "metric-row"
      :space-evenly false

      (label
        :class "metric-name"
        :halign "start"
        :hexpand true
        :text name)

      (label
        :class "metric-value"
        :halign "end"
        :text "${value}°C"))

    (progress
      :class "metric-bar ${bar-class}"
      :value value
      :orientation "horizontal")))

(defwindow patdesk
  :monitor "DP-0"
  :geometry (geometry
    :anchor "top right"
    :x "-120px"
    :y "20px"
    :width "420px"
    :height "1260px")

  :stacking "bg"
  :windowtype "desktop"

  (box
    :orientation "vertical"
    :class "main"
    :space-evenly false

    (label
      :class "clock"
      :text time)

    (label
      :class "date"
      :text date)

    (box :class "separator")

    (box
      :orientation "vertical"
      :class "stats"
      :space-evenly false

      (metric :name "PROCESSEUR" :value cpu :bar-class "cpu-bar")
      (metric :name "MÉMOIRE RAM" :value ram :bar-class "ram-bar"))

    (box :class "separator disk-separator")

    (label
      :class "section-title"
      :halign "start"
      :text "DISQUES CONNECTÉS")

    (literal
      :class "disk-content"
      :content disks)

    (box :class "separator temp-separator")

    (label
      :class "section-title"
      :halign "start"
      :text "TEMPÉRATURES")

    (box
      :orientation "vertical"
      :class "temperature-list"
      :space-evenly false

      (temp-metric :name "PROCESSEUR" :value cpu_temp :bar-class "cpu-temp-bar" :warning 70 :critical 85)
      (temp-metric :name "RTX 3060" :value gpu_temp :bar-class "gpu-temp-bar" :warning 75 :critical 85))

    (box :class "separator network-separator")

    (label
      :class "section-title"
      :halign "start"
      :text "RÉSEAU")

    (literal
      :class "network-content"
      :content network)

    (box :class "separator updates-separator")

    (label
      :class "section-title"
      :halign "start"
      :text "MISES À JOUR")

    (literal
      :class "updates-content"
      :content updates)

    (box :class "separator shortcuts-separator")

    (label
      :class "section-title"
      :halign "start"
      :text "RACCOURCIS")

    (box
      :orientation "horizontal"
      :class "shortcut-list"
      :space-evenly true
      :spacing 8

      (button
        :class "shortcut-button patsecure-button"
        :tooltip "Ouvrir PatSecure"
        :onclick "bash $HOME/PatSecure/launch/patsecure-launcher.sh"
        (label :text "PatSecure"))

      (button
        :class "shortcut-button terminal-button"
        :tooltip "Ouvrir Deepin Terminal"
        :onclick "deepin-terminal"
        (label :text "Terminal"))

      (button
        :class "shortcut-button files-button"
        :tooltip "Ouvrir le dossier personnel"
        :onclick "dde-file-manager $HOME"
        (label :text "Fichiers")))

    (box
      :orientation "horizontal"
      :class "shortcut-list shortcut-list-web"
      :space-evenly true
      :spacing 8

      (button
        :class "shortcut-button site-button"
        :tooltip "Ouvrir Les projets de Pattoo"
        :onclick "xdg-open 'https://les-projets-de-pattoo.vercel.app'"
        (label :text "Mon site"))

      (button
        :class "shortcut-button chatgpt-button"
        :tooltip "Ouvrir ChatGPT"
        :onclick "xdg-open 'https://chatgpt.com/'"
        (label :text "ChatGPT")))))
