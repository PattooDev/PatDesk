(defpoll time
  :interval "1s"
  `date '+%H:%M:%S'`)

(defpoll date
  :interval "60s"
  `date '+%A %d %B %Y'`)

(defpoll cpu
  :interval "2s"
  `$HOME/.config/patdesk/scripts/cpu.sh`)

(defpoll ram
  :interval "2s"
  `$HOME/.config/patdesk/scripts/ram.sh`)

(defpoll disks
  :interval "30s"
  `$HOME/.config/patdesk/scripts/disks.py`)

(defwidget metric [name value bar-class]
  (box
    :orientation "vertical"
    :class "metric"
    :space-evenly false

    (box
      :orientation "horizontal"
      :class "metric-row"
      :space-evenly false

      (label
        :class "metric-name"
        :halign "start"
        :hexpand true
        :text name)

      (label
        :class "metric-value"
        :halign "end"
        :text "${value}%"))

    (progress
      :class "metric-bar ${bar-class}"
      :value value
      :orientation "horizontal")))

(defwindow patdesk
  :monitor "DP-0"
  :geometry (geometry
    :anchor "top right"
    :x "-120px"
    :y "20px"
    :width "420px"
    :height "760px")

  :stacking "bg"
  :windowtype "desktop"

  (box
    :orientation "vertical"
    :class "main"
    :space-evenly false

    (label
      :class "clock"
      :text time)

    (label
      :class "date"
      :text date)

    (box :class "separator")

    (box
      :orientation "vertical"
      :class "stats"
      :space-evenly false

      (metric :name "PROCESSEUR" :value cpu :bar-class "cpu-bar")
      (metric :name "MÉMOIRE RAM" :value ram :bar-class "ram-bar"))

    (box :class "separator disk-separator")

    (label
      :class "section-title"
      :halign "start"
      :text "DISQUES CONNECTÉS")

    (literal
      :class "disk-content"
      :content disks)))

