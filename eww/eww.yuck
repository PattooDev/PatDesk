(defpoll time
  :interval "1s"
  `date '+%H:%M:%S'`)

(defpoll date
  :interval "60s"
  `date '+%A %d %B %Y'`)

(defpoll cpu
  :interval "2s"
  "~/.config/eww/scripts/cpu.sh")

(defpoll ram
  :interval "2s"
  "~/.config/eww/scripts/ram.sh")

(defwidget stats []
  (box
    :orientation "vertical"
    (label :class "info" :text "💻 CPU : ${cpu}%")
    (label :class "info" :text "🧠 RAM : ${ram}%")))

(defwindow patdesk
  :monitor 1
  :geometry (geometry
    :anchor "top right"
    :x "20px"
    :y "5px"
    :width "380px"
    :height "220px")
  :stacking "overlay"
  :windowtype "normal"
  (box
    :orientation "vertical"
    :class "main"
    (label :class "clock" :text time)
    (label :class "date" :text date)
    (stats)))
